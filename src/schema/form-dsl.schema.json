{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ice-render/ice-web-components-dsl/schema/form-dsl.schema.json",
  "title": "ice-web-components-dsl · 表单 DSL",
  "description": "一份 JSON 声明 → 一张真表单。注意：DSL 里没有 left/top，布局由 layout 与引擎的箱式布局决定。",
  "type": "object",
  "required": ["kind", "fields"],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": { "const": 1, "description": "当前是 1" },
    "kind": { "const": "form", "description": "当前只支持 form" },
    "title": { "type": "string" },
    "description": { "type": "string", "description": "标题下的一句话说明" },
    "layout": { "enum": ["vertical", "horizontal"], "description": "标签在上（默认）或左侧" },
    "width": { "type": "number", "exclusiveMinimum": 0, "description": "宿主给的宽度不够时才用这个（宿主会覆盖）。不传退回 360" },
    "maxWidth": { "type": "number", "exclusiveMinimum": 0, "description": "表单最大宽度，默认 640。宿主给的宽度会被它夹住" },
    "gap": { "type": "number", "exclusiveMinimum": 0, "description": "字段间距，默认 12" },
    "submitText": {
      "type": ["string", "null"],
      "description": "提交按钮文案，默认「提交」；null 表示不生成提交按钮"
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/field" }
    }
  },
  "definitions": {
    "option": {
      "type": "object",
      "required": ["value"],
      "properties": {
        "value": { "type": "string" },
        "label": { "type": "string", "description": "省略时编译期用 value 兜底" },
        "disabled": { "type": "boolean" }
      }
    },
    "rule": {
      "type": "object",
      "properties": {
        "required": { "type": "boolean" },
        "min": { "type": "number" },
        "max": { "type": "number", "description": "rate 上是「满分几颗星」，会映射到组件的 count 并同时进规则" },
        "minLength": { "type": "number" },
        "maxLength": { "type": "number" },
        "pattern": { "type": "string", "description": "正则字符串（JSON 写不出正则字面量）" },
        "message": { "type": "string" }
      }
    },
    "field": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "description": "取值键，必须唯一；dependencies 也引用它" },
        "type": {
          "enum": [
            "text", "textarea", "password", "number", "slider",
            "checkbox", "switch", "radio-group", "checkbox-group", "select", "date",
            "color", "rate", "time", "segmented", "autocomplete",
            "cascader", "tree-select", "transfer", "date-range"
          ]
        },
        "label": { "type": "string", "description": "省略时用 name" },
        "placeholder": { "type": "string" },
        "default": {
          "description": "类型需与字段类型一致。形状是「类型 + 属性」的函数：date-range 要两头齐全的数组（如 [\"2026-01-01\",\"2026-01-31\"]）、transfer 与多选 select/tree-select 是数组、其余是标量"
        },

        "required": { "type": "boolean" },
        "min": { "type": "number", "description": "number/slider/rate 上会同时约束控件与生成规则（rate 上是「至少几颗星」）" },
        "max": { "type": "number", "description": "rate 上是「满分几颗星」，会映射到组件的 count 并同时进规则" },
        "minLength": { "type": "number" },
        "maxLength": { "type": "number", "description": "文本类字段上会同时限制输入长度与生成规则" },
        "pattern": { "type": "string" },
        "message": { "type": "string" },
        "rules": { "type": "array", "items": { "$ref": "#/definitions/rule" } },

        "dependencies": {
          "type": "array",
          "items": { "type": "string" },
          "description": "被依赖字段变化时本字段立刻重算（跨字段校验）"
        },

        "options": {
          "type": "array",
          "minItems": 1,
          "items": { "oneOf": [{ "type": "string" }, { "$ref": "#/definitions/option" }] },
          "description": "选项型字段必需（select / radio-group / checkbox-group / color / segmented / autocomplete / cascader / tree-select / transfer）。两种写法都行：[{value,label}] 或 [\"a\",\"b\"]；cascader / tree-select 可在项上写 children 往下嵌"
        },

        "step": { "type": "number" },
        "precision": { "type": "number" },
        "range": { "type": "boolean" },
        "mode": { "enum": ["single", "multiple", "tags"], "description": "select 支持三种；tree-select 只有 single / multiple（未列出的取值会给出诊断）" },
        "showSearch": { "type": "boolean" },
        "placement": {
          "enum": [
            "top", "topLeft", "topRight",
            "bottom", "bottomLeft", "bottomRight",
            "left", "leftTop", "leftBottom",
            "right", "rightTop", "rightBottom"
          ]
        },
        "direction": { "enum": ["horizontal", "vertical"] },
        "maxChecked": { "type": "number" },
        "format": { "enum": ["HH:mm:ss", "HH:mm"], "description": "time 的值格式（date 的 format 是函数，进不了 DSL）" },
        "separator": { "type": "string", "description": "cascader 已选路径的分隔符" },
        "block": { "type": "boolean", "description": "segmented 各段等宽铺满整条（默认 true）" },
        "allowClear": { "type": "boolean" },
        "showCount": { "type": "boolean" },
        "showToggle": { "type": "boolean" },

        "width": { "type": "number", "exclusiveMinimum": 0 },
        "props": { "type": "object", "description": "逃生舱：直通控件构造函数，内容不校验" }
      }
    }
  }
}
